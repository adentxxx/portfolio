generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BloubEmotion {
  id            String    @id
  label         String
  assetSrc      String
  idleAnimation String?
  companies     Company[]
  projects      Project[]
}

model Company {
  id           String       @id @default(cuid())
  name         String
  role         String
  dateLabel    String
  description  String
  logoSrc      String
  url          String?
  order        Int
  bloubEmotion String
  published    Boolean      @default(true)
  emotion      BloubEmotion @relation(fields: [bloubEmotion], references: [id])
}

model Project {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  dateLabel    String
  description  String
  tags         String
  logoSrc      String
  order        Int
  bloubEmotion String
  summary      String
  heroImage    String
  published    Boolean          @default(true)
  emotion      BloubEmotion     @relation(fields: [bloubEmotion], references: [id])
  sections     ProjectSection[]
}

model ProjectSection {
  id        String  @id @default(cuid())
  projectId String
  heading   String
  body      String
  imageSrc  String?
  sortOrder Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id             String @id @default("default")
  introHeadline  String
  introBio       String
  avatarSrc      String
  introLinksJson String
  contactHeadline String
  contactSubline  String
  contactLinksJson String
}
